{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short storyboard",
  "type": "object",
  "required": ["title", "language", "audience", "intent", "style", "seed", "characters", "voices", "music", "end_card", "shots"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "audience": {"type": "string", "minLength": 10},
    "intent": {"type": "string", "minLength": 10},
    "style": {"type": "string", "minLength": 5},
    "seed": {"type": "integer"},
    "characters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 10}
    },
    "voices": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 2}
    },
    "music": {
      "type": "object",
      "required": ["prompt"],
      "additionalProperties": false,
      "properties": {"prompt": {"type": "string", "minLength": 5}}
    },
    "end_card": {
      "type": "object",
      "required": ["text", "duration"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 3},
        "duration": {"type": "number", "minimum": 2, "maximum": 8}
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/shot"}
    }
  },
  "$defs": {
    "shot": {
      "type": "object",
      "required": ["id", "reason", "duration", "image_prompt", "motion", "narration"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^s[0-9]{2}$"},
        "reason": {"type": "string", "minLength": 15, "description": "Why this shot exists (design thinking)."},
        "duration": {"type": "number", "minimum": 3, "maximum": 15},
        "image_prompt": {"type": "string", "minLength": 10},
        "characters": {"type": "array", "items": {"type": "string"}},
        "motion": {"enum": ["zoom_in", "zoom_out", "pan_left", "pan_right", "wan"]},
        "narration": {
          "type": "object",
          "required": ["speaker", "text"],
          "additionalProperties": false,
          "properties": {
            "speaker": {"type": "string"},
            "text": {"type": "string", "minLength": 3},
            "delivery": {"type": "string"}
          }
        }
      }
    }
  }
}
